{
  "name": "@adlab/sim",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sim:smoke": "tsx src/smoke.ts",
    "fixtures:check": "tsx src/fixtures.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "sim:spike": "tsx spike/run.ts",
    "sim:spike:mechanics": "tsx spike/mechanics.ts",
    "sim:run": "tsx src/cli.ts",
    "sim:worker": "tsx src/worker.ts",
    "test:module": "esbuild ../spacetime/src/index.ts --bundle --format=esm --platform=neutral --external:spacetimedb --external:spacetimedb/server '--external:spacetime:sys*' --outfile=.cache/module.mjs --log-level=warning && node --import ./test/module/register.mjs --import tsx --test test/module/module.test.ts",
    "sim:local-seed": "tsx src/local-seed.ts",
    "sim:pin": "tsx src/pin.ts",
    "sim:replay": "tsx src/replay.ts"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "p-limit": "7.3.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
