    "sim:run": "tsx src/cli.ts"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "p-limit": "7.3.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
