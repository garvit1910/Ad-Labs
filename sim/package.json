{
  "name": "@adlab/sim",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sim:smoke": "tsx src/smoke.ts",
    "fixtures:check": "tsx src/fixtures.ts",
