# Copy to .env.local and fill in. Secrets live only in .env.local, never in git.

# --- Keys ---
APIFY_TOKEN=
OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string (Supabase > Connect); used for pgvector and migrations
SUPABASE_CONNECTION_STRING=
# SpacetimeDB Maincloud, shared by A and B
SPACETIMEDB_URI=https://maincloud.spacetimedb.com
SPACETIMEDB_DB_NAME=adlab-calhacks13
# Optional browser overrides for the live sim views (lib/spacetime/config.ts defaults to the two above)
# NEXT_PUBLIC_SPACETIMEDB_URI=https://maincloud.spacetimedb.com
# NEXT_PUBLIC_SPACETIMEDB_DB_NAME=adlab-calhacks13
# Jev (TypeSafe), used by B's sim
TYPESAFE_API_KEY=
# Fetch.ai
AGENTVERSE_TOKEN=
ASI1_API_KEY=
# Seed for the Ad Lab uAgent; fixes its agent1q... address. Any long random string.
AD_LAB_AGENT_SEED=
# Only if B's perception step uses Claude
ANTHROPIC_API_KEY=

# --- Settings ---
LLM_FLEX_TIER=0
APIFY_AD_LIBRARY_MAX_ADS=50
CREATIVE_JUDGE_GATE_MODE=off
