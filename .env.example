# Copy to .env.local and fill in. Secrets live only in .env.local, never in git.

# --- Keys ---
APIFY_TOKEN=
OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string (Supabase > Connect); used for pgvector and migrations
SUPABASE_CONNECTION_STRING=
# SpacetimeDB Maincloud, shared by A and B
SPACETIMEDB_URI=https://maincloud.spacetimedb.com
SPACETIMEDB_DB_NAME=adlab-calhacks13
# Optional browser overrides for the live sim views (lib/spacetime/config.ts defaults to the two above)
# NEXT_PUBLIC_SPACETIMEDB_URI=https://maincloud.spacetimedb.com
# NEXT_PUBLIC_SPACETIMEDB_DB_NAME=adlab-calhacks13
# Jev (TypeSafe), used by B's sim
TYPESAFE_API_KEY=
# Fetch.ai
AGENTVERSE_TOKEN=
ASI1_API_KEY=
# Seed for the Ad Lab uAgent; fixes its agent1q... address. Any long random string.
AD_LAB_AGENT_SEED=
# Seeds for A6's other three agents (python3 -c "import secrets;print(secrets.token_hex(32))")
SCOUT_AGENT_SEED=
STRATEGIST_AGENT_SEED=
COPYWRITER_AGENT_SEED=
# Only if B's perception step uses Claude
ANTHROPIC_API_KEY=

# --- Settings ---
LLM_FLEX_TIER=0
APIFY_AD_LIBRARY_MAX_ADS=50
CREATIVE_JUDGE_GATE_MODE=off

# --- A6 agents (docs/AGENT_API.md). The dev:local / dev:live npm scripts set these per run; leave unset here ---
# test (default): refreshes are dry and distill never runs. live: only `npm run dev:live` sets it
# ADLAB_AGENT_MODE=test
# The agents' API base
# ADLAB_API_URL=http://localhost:3000/api/agent
# The stage database's name if adlab-live is taken on Maincloud
# ADLAB_LIVE_DB_NAME=adlab-live
# The Strategist's rounds per run (warm-up excluded)
# STRATEGIST_ROUNDS_PLANNED=3
# Bureau port for `npm run agents`
# ADLAB_AGENTS_PORT=8001
# Job worker: skip every brand_object_* job (worker:live sets it), and mirror jobs into ingest_job
# ADLAB_FREEZE_BRAND_OBJECT=1
# ADLAB_INGEST_MIRROR=1
# next dev only: log genome defects instead of throwing (the dev:* scripts set it)
# CREATIVE_GENOME_STRICT=off
# The Payment Protocol stays off
# ADLAB_PAYMENT=0
