{
  "name": "adlab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check:connections": "tsx scripts/check-connections.mts",
    "setup:supabase": "tsx scripts/setup-supabase.mts",
    "db:migrate": "tsx supabase/migrate.mts",
    "worker": "node --env-file-if-exists=.env.local --import tsx worker/index.ts",
    "a2:ingest": "node --env-file-if-exists=.env.local --import tsx scripts/a2-ingest.ts",
    "a3:distill": "node --env-file-if-exists=.env.local --import tsx scripts/a3-distill.ts",
    "a3:report": "node --env-file-if-exists=.env.local --import tsx scripts/a3-report.ts",
    "a4:rows": "node --env-file-if-exists=.env.local --import tsx scripts/a4-build-rows.ts",
    "sim:images": "node --env-file-if-exists=.env.local --import tsx scripts/sim-images.ts",
    "a5:creatives": "NODE_ENV=production CREATIVE_JUDGE_GATE_MODE=off node --env-file-if-exists=.env.local --import tsx scripts/a5-creatives.ts",
    "spacetime:publish": "spacetime publish adlab-calhacks13 --server maincloud --module-path spacetime --yes=remote",
    "spacetime:publish:clear": "spacetime publish adlab-calhacks13 --server maincloud --module-path spacetime --delete-data --yes",
    "spacetime:generate": "spacetime generate --lang typescript --out-dir lib/spacetime/bindings --module-path spacetime --yes",
    "spacetime:publish:local": "spacetime publish adlab-local --server http://127.0.0.1:3100 --module-path spacetime --yes",
    "spacetime:publish:live": "spacetime publish ${ADLAB_LIVE_DB_NAME:-adlab-live} --server maincloud --module-path spacetime --yes=remote",
    "spacetime:publish:live:clear": "spacetime publish ${ADLAB_LIVE_DB_NAME:-adlab-live} --server maincloud --module-path spacetime --delete-data --yes",
    "bench": "node --env-file-if-exists=.env.local --import tsx scripts/bench.ts",
    "bench:seed": "node --env-file-if-exists=.env.local --import tsx scripts/bench.ts seed",
    "bench:server": "spacetime start --listen-addr 127.0.0.1:3100 --in-memory",
    "bench:reset:local": "spacetime publish adlab-local --server http://127.0.0.1:3100 --module-path spacetime --delete-data --yes && npm run bench -- seed --target local --from-snapshot",
    "dev:local": "SPACETIMEDB_URI=http://127.0.0.1:3100 SPACETIMEDB_DB_NAME=adlab-local NEXT_PUBLIC_SPACETIMEDB_URI=http://127.0.0.1:3100 NEXT_PUBLIC_SPACETIMEDB_DB_NAME=adlab-local ADLAB_AGENT_MODE=test CREATIVE_GENOME_STRICT=off next dev",
    "dev:live": "SPACETIMEDB_URI=https://maincloud.spacetimedb.com SPACETIMEDB_DB_NAME=${ADLAB_LIVE_DB_NAME:-adlab-live} NEXT_PUBLIC_SPACETIMEDB_URI=https://maincloud.spacetimedb.com NEXT_PUBLIC_SPACETIMEDB_DB_NAME=${ADLAB_LIVE_DB_NAME:-adlab-live} ADLAB_AGENT_MODE=live CREATIVE_GENOME_STRICT=off next dev",
    "sim:worker:local": "SPACETIMEDB_URI=http://127.0.0.1:3100 SPACETIMEDB_DB_NAME=adlab-local npm --prefix sim run sim:worker",
    "sim:worker:live": "SPACETIMEDB_URI=https://maincloud.spacetimedb.com SPACETIMEDB_DB_NAME=${ADLAB_LIVE_DB_NAME:-adlab-live} npm --prefix sim run sim:worker",
    "a5:worker:local": "SPACETIMEDB_URI=http://127.0.0.1:3100 SPACETIMEDB_DB_NAME=adlab-local npm run a5:creatives -- worker",
    "a5:worker:live": "SPACETIMEDB_URI=https://maincloud.spacetimedb.com SPACETIMEDB_DB_NAME=${ADLAB_LIVE_DB_NAME:-adlab-live} npm run a5:creatives -- worker",
    "worker:live": "APIFY_AD_LIBRARY_MAX_ADS=10 ADLAB_FREEZE_BRAND_OBJECT=1 ADLAB_INGEST_MIRROR=1 SPACETIMEDB_URI=https://maincloud.spacetimedb.com SPACETIMEDB_DB_NAME=${ADLAB_LIVE_DB_NAME:-adlab-live} node --env-file-if-exists=.env.local --import tsx worker/index.ts --watch",
    "agent": "uv run --project agents python agents/hello_agent.py",
    "agents": "uv run --project agents python agents/run_all.py",
    "agents:solo": "uv run --project agents python agents/run_all.py --solo",
    "agents:addresses": "uv run --project agents python agents/run_all.py --print-addresses",
    "agents:e2e": "uv run --project agents python agents/e2e.py",
    "agents:test": "uv run --project agents python -m unittest discover -s agents/tests -t agents",
    "sim:smoke": "npm --prefix sim run sim:smoke",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "test:all": "npm run typecheck && npm test && npx tsx --test app/sim/_lib/selectors.test.ts && npm --prefix sim run typecheck && npm --prefix sim test && npm --prefix sim run test:module && npm run agents:test"
  },
  "dependencies": {
    "@google/genai": "1.38.0",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-progress": "1.1.7",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.7",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-tooltip": "1.2.8",
    "@supabase/supabase-js": "2.75.0",
    "@tanstack/react-query": "5.90.3",
    "apify-client": "2.23.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.503.0",
    "next": "16.4.3",
    "next-intl": "4.14.8",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "2.15.4",
    "sharp": "0.35.5",
    "sonner": "2.0.7",
    "spacetimedb": "2.13.0",
    "tailwind-merge": "3.3.1",
    "undici": "6.29.1",
    "zod": "3.25.76",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3"
  }
}
